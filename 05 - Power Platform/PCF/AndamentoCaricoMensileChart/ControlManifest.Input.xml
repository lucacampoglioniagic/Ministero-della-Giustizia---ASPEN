<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="AgicAspen" constructor="AndamentoCaricoMensileChart" version="1.0.0"
    display-name-key="Andamento Carico Mensile"
    description-key="Andamento nel tempo del carico cumulato per magistrato"
    control-type="standard">
    <external-service-usage enabled="false" />
    <!--
      Tabella sorgente: agc_fascicolo2
      Poiché il carico non diminuisce alla chiusura del fascicolo (solo la riassegnazione lo
      scarica), l'andamento nel tempo del carico cumulato per magistrato, calcolato sommando
      progressivamente agc_pesocalcolato dei fascicoli assegnati ordinati per agc_datacaso, dà
      una lettura diretta di come il carico di ciascun magistrato è cresciuto mese per mese.
      Mapping consigliato:
        magistratoField  →  agc_magistratocontatto  (Lookup → contact [display: Magistrato])
        pesoField        →  agc_pesocalcolato        (Decimal, campo calcolato)
        dataField        →  agc_datacaso             (DateTime)
    -->
    <type-group name="pesoTypes">
      <type>Whole.None</type>
      <type>FP</type>
      <type>Decimal</type>
    </type-group>
    <data-set name="fascicoliDataSet" display-name-key="Fascicoli">
      <property-set name="magistratoField" display-name-key="Magistrato (lookup)"
        of-type="Lookup.Simple" usage="bound" required="true" />
      <property-set name="pesoField" display-name-key="Peso"
        of-type-group="pesoTypes" usage="bound" required="true" />
      <property-set name="dataField" display-name-key="Data caso"
        of-type="DateAndTime.DateAndTime" usage="bound" required="true" />
    </data-set>
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/chart.css" order="1" />
    </resources>
  </control>
</manifest>
