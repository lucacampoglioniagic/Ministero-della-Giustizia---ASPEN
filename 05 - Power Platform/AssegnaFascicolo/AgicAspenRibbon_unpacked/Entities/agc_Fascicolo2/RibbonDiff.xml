<?xml version="1.0" encoding="utf-8"?>
<RibbonDiffXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CustomActions>
    <!-- Nasconde comandi standard non necessari nella homepage grid Fascicoli 2.
         Location verificate il 07/07/2026 tramite RetrieveEntityRibbon sull'ambiente live
         (le precedenti Location erano ID "di manuale" mai esistiti sull'entita' e quindi
         non avevano alcun effetto). "Mostra grafico" (ShowChartPane) non e' inclusa: e'
         un comando della command bar moderna iniettato dalla piattaforma, non presente nel
         RibbonXml classico, quindi non nascondibile con HideCustomAction; e' presente anche
         su agc_fascicolo (vecchia tabella), quindi la parita' resta comunque garantita. -->
    <HideCustomAction Id="agc.Hide.HomepageGrid.agc_fascicolo2.ShowThisView"
      Location="Mscrm.HomepageGrid.agc_fascicolo2.MainTab.QuickPowerBI.Button"
      HideActionId="agc.Hide.HomepageGrid.agc_fascicolo2.ShowThisView.Hide" />
    <!-- Il tasto "Chiudi Caso" nella form non serve piu' al cliente: nascosto (non solo
         disabilitato) tramite HideCustomAction diretta sul controllo esistente. -->
    <HideCustomAction Id="agc.Hide.Form.agc_fascicolo2.MainTab.Save.Chiudi"
      Location="agc.Form.agc_fascicolo2.MainTab.Save.Chiudi.Button"
      HideActionId="agc.Hide.Form.agc_fascicolo2.MainTab.Save.Chiudi.Hide" />
    <HideCustomAction Id="agc.Hide.HomepageGrid.agc_fascicolo2.SendLinkByEmail"
      Location="Mscrm.HomepageGrid.agc_fascicolo2.Send"
      HideActionId="agc.Hide.HomepageGrid.agc_fascicolo2.SendLinkByEmail.Hide" />
    <!-- "Invia link tramite messaggio e-mail" e' anche renderizzato da questi due controlli
         OOB paralleli (versione classica e "modern"): senza nasconderli entrambi il pulsante
         resta comunque visibile in griglia. -->
    <HideCustomAction Id="agc.Hide.HomepageGrid.agc_fascicolo2.SendDirectEmail"
      Location="Mscrm.HomepageGrid.agc_fascicolo2.SendDirectEmail"
      HideActionId="agc.Hide.HomepageGrid.agc_fascicolo2.SendDirectEmail.Hide" />
    <HideCustomAction Id="agc.Hide.HomepageGrid.agc_fascicolo2.ModernSendDirectEmail"
      Location="Mscrm.HomepageGrid.agc_fascicolo2.modern.SendDirectEmail"
      HideActionId="agc.Hide.HomepageGrid.agc_fascicolo2.ModernSendDirectEmail.Hide" />
    <HideCustomAction Id="agc.Hide.HomepageGrid.agc_fascicolo2.RunFlow"
      Location="Mscrm.HomepageGrid.agc_fascicolo2.Flows.RefreshCommandBar"
      HideActionId="agc.Hide.HomepageGrid.agc_fascicolo2.RunFlow.Hide" />
    <!-- Sotto-voce annidata con lo stesso Command/Label: e' quella effettivamente
         renderizzata nella griglia web, va nascosta separatamente dall'anchor sopra. -->
    <HideCustomAction Id="agc.Hide.HomepageGrid.agc_fascicolo2.RunFlowNested"
      Location="Mscrm.HomepageGrid.agc_fascicolo2.Flows.RefreshCommandBar.Flows"
      HideActionId="agc.Hide.HomepageGrid.agc_fascicolo2.RunFlowNested.Hide" />
    <HideCustomAction Id="agc.Hide.HomepageGrid.agc_fascicolo2.RunReport"
      Location="Mscrm.HomepageGrid.agc_fascicolo2.RunReport"
      HideActionId="agc.Hide.HomepageGrid.agc_fascicolo2.RunReport.Hide" />

    <!-- Tasto nella FORM del fascicolo -->
    <CustomAction Id="agc.Form.agc_fascicolo2.MainTab.Save.Assegna.CustomAction"
      Location="Mscrm.Form.agc_fascicolo2.MainTab.Save.Controls._children"
      Sequence="21">
      <CommandUIDefinition>
        <Button Id="agc.Form.agc_fascicolo2.MainTab.Save.Assegna.Button"
          Command="agc.Form.agc_fascicolo2.Assegna.Command"
          LabelText="Assegna Fascicolo"
          Alt="Assegna Fascicolo"
          ToolTipTitle="Assegna Fascicolo"
          ToolTipDescription="Avvia il processo di assegnazione del fascicolo a un magistrato"
          TemplateAlias="o1"
          Sequence="21"
          ModernImage="$webresource:agc_assignfascicolo_icon.svg" />
      </CommandUIDefinition>
    </CustomAction>

    <!-- Tasto chiusura caso nella FORM del fascicolo -->
    <CustomAction Id="agc.Form.agc_fascicolo2.MainTab.Save.Chiudi.CustomAction"
      Location="Mscrm.Form.agc_fascicolo2.MainTab.Save.Controls._children"
      Sequence="22">
      <CommandUIDefinition>
        <Button Id="agc.Form.agc_fascicolo2.MainTab.Save.Chiudi.Button"
          Command="agc.Form.agc_fascicolo2.Chiudi.Command"
          LabelText="Chiudi Caso"
          Alt="Chiudi Caso"
          ToolTipTitle="Chiudi Caso"
          ToolTipDescription="Chiude il fascicolo dopo conferma"
          TemplateAlias="o1"
          Sequence="22"
          ModernImage="$webresource:agc_closefascicolo_icon.svg" />
      </CommandUIDefinition>
    </CustomAction>

    <!-- Tasto nella VISTA (grid) del fascicolo -->
    <CustomAction Id="agc.HomepageGrid.agc_fascicolo2.MainTab.Actions.Assegna.CustomAction"
      Location="Mscrm.HomepageGrid.agc_fascicolo2.MainTab.Actions.Controls._children"
      Sequence="21">
      <CommandUIDefinition>
        <Button Id="agc.HomepageGrid.agc_fascicolo2.MainTab.Actions.Assegna.Button"
          Command="agc.HomepageGrid.agc_fascicolo2.Assegna.Command"
          LabelText="Assegna Fascicolo"
          Alt="Assegna Fascicolo"
          ToolTipTitle="Assegna Fascicolo"
          ToolTipDescription="Avvia il processo di assegnazione del fascicolo a un magistrato"
          TemplateAlias="o1"
          Sequence="21"
          ModernImage="$webresource:agc_assignfascicolo_icon.svg" />
      </CommandUIDefinition>
    </CustomAction>

  </CustomActions>
  <Templates>
    <RibbonTemplates Id="Mscrm.Templates"></RibbonTemplates>
  </Templates>
  <CommandDefinitions>

    <!-- Command FORM -->
    <CommandDefinition Id="agc.Form.agc_fascicolo2.Assegna.Command">
      <EnableRules>
        <EnableRule Id="Mscrm.FormStateExistingOrReadOnly" />
        <EnableRule Id="agc.Assegna.NotAssigned.Form.EnableRule" />
      </EnableRules>
      <DisplayRules />
      <Actions>
        <JavaScriptFunction FunctionName="AgicAspen.AssegnaFascicolo.openDialog"
          Library="$webresource:agc_assignfascicolo.js">
          <CrmParameter Value="PrimaryControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>

    <!-- Command FORM chiusura -->
    <CommandDefinition Id="agc.Form.agc_fascicolo2.Chiudi.Command">
      <EnableRules>
        <EnableRule Id="Mscrm.FormStateExistingOrReadOnly" />
        <EnableRule Id="agc.Chiudi.NotClosed.Form.EnableRule" />
      </EnableRules>
      <DisplayRules />
      <Actions>
        <JavaScriptFunction FunctionName="AgicAspen.AssegnaFascicolo.openCloseDialog"
          Library="$webresource:agc_assignfascicolo.js">
          <CrmParameter Value="PrimaryControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>

    <!-- Command GRID -->
    <CommandDefinition Id="agc.HomepageGrid.agc_fascicolo2.Assegna.Command">
      <EnableRules>
        <EnableRule Id="agc.Assegna.SingleSelection.EnableRule" />
        <EnableRule Id="agc.Assegna.NotAssigned.Grid.EnableRule" />
      </EnableRules>
      <DisplayRules />
      <Actions>
        <JavaScriptFunction FunctionName="AgicAspen.AssegnaFascicolo.openDialogFromGrid"
          Library="$webresource:agc_assignfascicolo.js">
          <CrmParameter Value="SelectedControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>

  </CommandDefinitions>
  <RuleDefinitions>
    <TabDisplayRules />
    <DisplayRules />
    <EnableRules>

      <!-- Esattamente 1 record selezionato nella grid -->
      <EnableRule Id="agc.Assegna.SingleSelection.EnableRule">
        <SelectionCountRule AppliesTo="SelectedEntity" Minimum="1" Maximum="1" />
      </EnableRule>

      <!-- Form: disabilita se agc_magistratoassegnato già valorizzato -->
      <EnableRule Id="agc.Assegna.NotAssigned.Form.EnableRule">
        <CustomRule FunctionName="AgicAspen.AssegnaFascicolo.isEnabledForm"
          Library="$webresource:agc_assignfascicolo.js"
          Default="false">
          <CrmParameter Value="PrimaryControl" />
        </CustomRule>
      </EnableRule>

      <!-- Form: disabilita chiusura se già chiuso -->
      <EnableRule Id="agc.Chiudi.NotClosed.Form.EnableRule">
        <CustomRule FunctionName="AgicAspen.AssegnaFascicolo.isCloseEnabledForm"
          Library="$webresource:agc_assignfascicolo.js"
          Default="false">
          <CrmParameter Value="PrimaryControl" />
        </CustomRule>
      </EnableRule>

      <!-- Grid: disabilita se agc_magistratoassegnato già valorizzato -->
      <EnableRule Id="agc.Assegna.NotAssigned.Grid.EnableRule">
        <CustomRule FunctionName="AgicAspen.AssegnaFascicolo.isEnabledGrid"
          Library="$webresource:agc_assignfascicolo.js"
          Default="false">
          <CrmParameter Value="SelectedControl" />
        </CustomRule>
      </EnableRule>

    </EnableRules>
  </RuleDefinitions>
  <LocLabels />
</RibbonDiffXml>