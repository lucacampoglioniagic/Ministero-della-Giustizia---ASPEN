<?xml version="1.0" encoding="utf-8"?>
<RibbonDiffXml>
  <CustomActions>

    <!-- Tasto nella FORM del fascicolo -->
    <CustomAction Id="agc.Form.agc_fascicolo.MainTab.Save.Assegna.CustomAction"
      Location="Mscrm.Form.agc_fascicolo.MainTab.Save.Controls._children"
      Sequence="21">
      <CommandUIDefinition>
        <Button Id="agc.Form.agc_fascicolo.MainTab.Save.Assegna.Button"
          Command="agc.Form.agc_fascicolo.Assegna.Command"
          LabelText="Assegna Fascicolo"
          Alt="Assegna Fascicolo"
          ToolTipTitle="Assegna Fascicolo"
          ToolTipDescription="Avvia il processo di assegnazione del fascicolo a un magistrato"
          TemplateAlias="o1"
          Sequence="21"
          ModernImage="$webresource:agc_assignfascicolo_icon.svg" />
      </CommandUIDefinition>
    </CustomAction>

    <!-- Tasto nella VISTA (grid) del fascicolo -->
    <CustomAction Id="agc.HomepageGrid.agc_fascicolo.MainTab.Actions.Assegna.CustomAction"
      Location="Mscrm.HomepageGrid.agc_fascicolo.MainTab.Actions.Controls._children"
      Sequence="21">
      <CommandUIDefinition>
        <Button Id="agc.HomepageGrid.agc_fascicolo.MainTab.Actions.Assegna.Button"
          Command="agc.HomepageGrid.agc_fascicolo.Assegna.Command"
          LabelText="Assegna Fascicolo"
          Alt="Assegna Fascicolo"
          ToolTipTitle="Assegna Fascicolo"
          ToolTipDescription="Avvia il processo di assegnazione del fascicolo a un magistrato"
          TemplateAlias="o1"
          Sequence="21"
          ModernImage="$webresource:agc_assignfascicolo_icon.svg" />
      </CommandUIDefinition>
    </CustomAction>

  </CustomActions>

  <CommandDefinitions>

    <!-- Command FORM -->
    <CommandDefinition Id="agc.Form.agc_fascicolo.Assegna.Command">
      <EnableRules>
        <EnableRule Id="Mscrm.FormStateExistingOrReadOnly" />
        <EnableRule Id="agc.Assegna.NotAssigned.Form.EnableRule" />
      </EnableRules>
      <DisplayRules />
      <Actions>
        <JavaScriptFunction FunctionName="AgicAspen.AssegnaFascicolo.openDialog"
          Library="$webresource:agc_assignfascicolo.js">
          <CrmParameter Value="PrimaryControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>

    <!-- Command GRID -->
    <CommandDefinition Id="agc.HomepageGrid.agc_fascicolo.Assegna.Command">
      <EnableRules>
        <EnableRule Id="agc.Assegna.SingleSelection.EnableRule" />
        <EnableRule Id="agc.Assegna.NotAssigned.Grid.EnableRule" />
      </EnableRules>
      <DisplayRules />
      <Actions>
        <JavaScriptFunction FunctionName="AgicAspen.AssegnaFascicolo.openDialogFromGrid"
          Library="$webresource:agc_assignfascicolo.js">
          <CrmParameter Value="SelectedControl" />
        </JavaScriptFunction>
      </Actions>
    </CommandDefinition>

  </CommandDefinitions>

  <RuleDefinitions>
    <TabDisplayRules />
    <DisplayRules />
    <EnableRules>

      <!-- Esattamente 1 record selezionato nella grid -->
      <EnableRule Id="agc.Assegna.SingleSelection.EnableRule">
        <SelectionCountRule AppliesTo="SelectedEntity" Minimum="1" Maximum="1" />
      </EnableRule>

      <!-- Form: disabilita se agc_magistratoassegnato già valorizzato -->
      <EnableRule Id="agc.Assegna.NotAssigned.Form.EnableRule">
        <CustomRule FunctionName="AgicAspen.AssegnaFascicolo.isEnabledForm"
          Library="$webresource:agc_assignfascicolo.js"
          Default="false">
          <CrmParameter Value="PrimaryControl" />
        </CustomRule>
      </EnableRule>

      <!-- Grid: disabilita se agc_magistratoassegnato già valorizzato -->
      <EnableRule Id="agc.Assegna.NotAssigned.Grid.EnableRule">
        <CustomRule FunctionName="AgicAspen.AssegnaFascicolo.isEnabledGrid"
          Library="$webresource:agc_assignfascicolo.js"
          Default="false">
          <CrmParameter Value="SelectedControl" />
        </CustomRule>
      </EnableRule>

    </EnableRules>
  </RuleDefinitions>

  <Templates />
</RibbonDiffXml>